{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterAccountRequest",
  "type": "object",
  "properties": {
    "login": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "email": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_!#$%&'*+/=?`{|}~^.-]+@[a-zA-Z0-9.-]+$"
    },
    "password": {
      "type": "string",
      "minLength": 1
    },
    "consentPersonalData": {
      "type": "boolean"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    }
  },
  "required": [
    "login",
    "password",
    "consentPersonalData",
    "username"
  ],
  "additionalProperties": false
}
